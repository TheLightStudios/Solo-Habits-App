<%# app/views/workouts/_form.html.erb %>
<%= form_with model: workout, class: "space-y-4" do |f| %>
  <% if workout.errors.any? %>
    <div class="p-3 border border-red-500 text-red-300 rounded">
      <% workout.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nome da rotina", class: "block mb-1 text-sm text-slate-400" %>
    <%= f.text_field :name, placeholder: "Ex.: Treino A - Peito e Tríceps",
          class: "w-full p-2 bg-slate-900 text-slate-100 border border-slate-700 rounded" %>
  </div>

  <%= f.submit "Salvar", class: "px-4 py-2 bg-cyan-500 text-slate-950 font-bold rounded cursor-pointer" %>
  <%= link_to "Cancelar", workouts_path, class: "ml-3 text-slate-400" %>
<% end %>