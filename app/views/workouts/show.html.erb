<%# app/views/workouts/show.html.erb %>
<div class="flex justify-between items-center mb-2">
  <h1 class="text-2xl font-bold text-cyan-400"><%= @workout.name %></h1>
  <%= link_to "+ Exercício", new_workout_exercise_path(@workout),
        class: "px-4 py-2 border border-cyan-400 text-cyan-300 rounded hover:bg-cyan-400/10" %>
</div>

<div class="flex items-center gap-4 text-sm mb-6">
  <%= link_to "← Voltar", workouts_path, class: "text-slate-400 hover:text-white" %>
  <%= link_to "Renomear", edit_workout_path(@workout), class: "text-slate-400 hover:text-white" %>
  <%= button_to "Apagar rotina", workout_path(@workout), method: :delete,
        form: { data: { turbo_confirm: "Apagar esta rotina e todos os exercícios dela?" } },
        class: "text-red-400 hover:text-red-300" %>
</div>

<% if @exercises.empty? %>
  <p class="text-slate-400">Essa rotina ainda não tem exercícios. Adicione o primeiro.</p>
<% end %>

<ul class="space-y-3">
  <% @exercises.each do |exercise| %>
    <li class="flex justify-between items-center p-4 border border-slate-700 rounded">
      <div>
        <p class="font-semibold"><%= exercise.name %></p>
        <p class="text-xs text-slate-400">
          <% if exercise.details.present? %><%= exercise.details %> · <% end %>+<%= exercise.xp_reward %> XP
        </p>
      </div>

      <div class="flex items-center gap-3 text-sm">
        <% if @done_ids.include?(exercise.id) %>
          <span class="text-green-400">✔ Feito</span>
        <% else %>
          <%= button_to "Marcar", workout_exercise_completion_path(@workout, exercise),
                class: "px-3 py-1 bg-cyan-500 text-slate-950 font-bold rounded hover:bg-cyan-300" %>
        <% end %>
        <%= link_to "Editar", edit_workout_exercise_path(@workout, exercise), class: "text-slate-400 hover:text-white" %>
        <%= button_to "Apagar", workout_exercise_path(@workout, exercise), method: :delete,
              form: { data: { turbo_confirm: "Apagar este exercício?" } },
              class: "text-red-400 hover:text-red-300" %>
      </div>
    </li>
  <% end %>
</ul>