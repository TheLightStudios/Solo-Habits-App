<div class="max-w-md mx-auto mt-10 p-6 border border-cyan-500/40 rounded bg-slate-900/60 shadow-[0_0_25px_rgba(34,211,238,0.15)]">
  <h2 class="text-xl font-bold text-cyan-400 tracking-widest mb-1">NOVO CAÇADOR</h2>
  <p class="text-sm text-slate-400 mb-6">[SISTEMA] Você foi selecionado. Registre-se para começar.</p>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <% if resource.errors.any? %>
      <div class="p-3 border border-red-500 bg-red-950/50 text-red-300 rounded text-sm">
        <% resource.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :email, "E-mail", class: "block mb-1 text-sm text-slate-400" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "w-full p-2 bg-slate-950 text-slate-100 border border-slate-700 rounded focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "block mb-1 text-sm text-slate-400" %>
      <% if @minimum_password_length %>
        <span class="text-xs text-slate-500">(mínimo de <%= @minimum_password_length %> caracteres)</span>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password",
            class: "w-full p-2 bg-slate-950 text-slate-100 border border-slate-700 rounded focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirmar senha", class: "block mb-1 text-sm text-slate-400" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "w-full p-2 bg-slate-950 text-slate-100 border border-slate-700 rounded focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400" %>
    </div>

    <%= f.submit "Criar conta", class: "w-full py-2 bg-cyan-500 text-slate-950 font-bold rounded cursor-pointer hover:bg-cyan-300 transition" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>