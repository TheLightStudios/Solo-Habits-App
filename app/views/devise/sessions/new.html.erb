<div class="max-w-md mx-auto mt-10 p-6 border border-cyan-500/40 rounded bg-slate-900/60 shadow-[0_0_25px_rgba(34,211,238,0.15)]">
  <h2 class="text-xl font-bold text-cyan-400 tracking-widest mb-1">LOGIN</h2>
  <p class="text-sm text-slate-400 mb-6">[SISTEMA] Identifique-se, Caçador.</p>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, "E-mail", class: "block mb-1 text-sm text-slate-400" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "w-full p-2 bg-slate-950 text-slate-100 border border-slate-700 rounded focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "block mb-1 text-sm text-slate-400" %>
      <%= f.password_field :password, autocomplete: "current-password",
            class: "w-full p-2 bg-slate-950 text-slate-100 border border-slate-700 rounded focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "accent-cyan-400 w-4 h-4" %>
        <%= f.label :remember_me, "Lembrar de mim", class: "text-sm text-slate-400" %>
      </div>
    <% end %>

    <%= f.submit "Entrar", class: "w-full py-2 bg-cyan-500 text-slate-950 font-bold rounded cursor-pointer hover:bg-cyan-300 transition" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>