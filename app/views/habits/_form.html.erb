<%= form_with model: habit, class: "space-y-4" do |f|%>
    <% if habit.errors.any? %>
        <div class="p-3 border border-red-500 text-red-300 rounded">
            <% habit.errors.full_messages.each do |msg|%>
                <p><%= msg %></p>
            <%end%>
        </div>
    <%end%>

    <div>
        <%=f.label :name, "Nome da Missão", class: "block mb-1 text-sm text-slate-400"%>
        <%= f.text_field :name, class: "w-full p-2 bg-slate-900 border border-slate-700 rounded"%>
    </div>

    <div>
        <%= f.label :category, "Categoria", class: "block mb-1 text-sm text-slate-400" %>
        <%= f.select :category, Habit::CATEGORY_ATTRIBUTES.keys.map { |c| [c.capitalize, c] },
            {}, class: "w-full p-2 bg-slate-900 border border-slate-700 rounded" %>
    </div>

    <div>
        <%= f.label :xp_reward, "XP (5 a #{current_user.max_task_xp})", class: "block mb-1 text-sm text-slate-400" %>
        <%= f.number_field :xp_reward, min: 5, max: current_user.max_task_xp,
                class: "w-full p-2 bg-slate-900 text-slate-100 border border-slate-700 rounded" %>
        <p class="mt-1 text-xs text-slate-500">
            No nível <%= current_user.next_xp_cap_level %> o limite sobe para <%= current_user.max_task_xp + User::TASK_XP_STEP %>.
        </p>
    </div>

    <div class="p-3 border border-red-500/40 rounded">
        <div class="flex items-center gap-2">
            <%= f.check_box :mandatory, class: "accent-cyan-400 w-4 h-4" %>
            <%= f.label :mandatory, "Missão obrigatória", class: "text-sm text-slate-300" %>
        </div>
        <p class="mt-1 text-xs text-slate-500">
            Se você não cumprir num dia, perde metade do XP da missão e a mesma quantidade de moedas.
        </p>
    </div>

    <%= f.submit "Salvar", class: "px-4 py-2 bg-cyan-500 text-slate-950 font-bold rounded cursor-pointer" %>
    <%= link_to "Cancelar", root_path, class: "ml-3 text-slate-400" %>
<% end %>