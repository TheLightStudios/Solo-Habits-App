<%# app/views/habits/index.html.erb %>
<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-cyan-400">MISSÕES DIÁRIAS</h1>
  <%= link_to "+ Nova missão", new_habit_path,
        class: "px-4 py-2 border border-cyan-400 text-cyan-300 rounded hover:bg-cyan-400/10" %>
</div>

<div class="mb-6 p-4 border border-cyan-500/30 rounded flex items-center justify-between gap-4">
  <div>
    <p>Nível <strong><%= current_user.level %></strong> · Rank <strong><%= current_user.rank %></strong></p>
    <p class="text-sm text-slate-400">
      XP: <%= current_user.xp %> / <%= current_user.xp_to_next_level %>
    </p>
  </div>

  <%= link_to edit_profile_path, title: "Trocar imagem" do %>
    <% if current_user.avatar.attached? %>
      <%= image_tag current_user.avatar,
            class: "w-20 h-20 rounded-full object-cover border-2 border-cyan-400 hover:border-cyan-200" %>
    <% else %>
      <div class="w-20 h-20 rounded-full border-2 border-dashed border-cyan-400 flex items-center justify-center text-xs text-cyan-400 text-center hover:border-cyan-200">
        Add foto
      </div>
    <% end %>
  <% end %>
</div>

<% if @habits.empty? %>
  <p class="text-slate-400">Nenhuma missão ainda. Crie a primeira.</p>
<% end %>

<ul class="space-y-3">
  <% @habits.each do |habit| %>
    <li class="flex justify-between items-center p-4 border border-slate-700 rounded">
      <div>
        <p class="font-semibold"><%= habit.name %></p>
        <p class="text-xs text-slate-400"><%= habit.category.capitalize %> · +<%= habit.xp_reward %> XP</p>
      </div>

      <div class="flex items-center gap-3 text-sm">
        <% if @done_ids.include?(habit.id) %>
          <span class="text-green-400">✔ Concluída</span>
        <% else %>
          <%= button_to "Concluir", habit_completion_path(habit),
                class: "px-3 py-1 bg-cyan-500 text-slate-950 font-bold rounded hover:bg-cyan-300" %>
        <% end %>
        <%= link_to "Editar", edit_habit_path(habit), class: "text-slate-400 hover:text-white" %>
        <%= button_to "Apagar", habit_path(habit), method: :delete,
              form: { data: { turbo_confirm: "Apagar esta missão?" } },
              class: "text-red-400 hover:text-red-300" %>
      </div>
    </li>
  <% end %>
</ul>

