<%# app/views/journal_entries/index.html.erb %>
<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-cyan-400">DIÁRIO DO CAÇADOR</h1>

  <% if @today_entry %>
    <%= link_to "Editar o de hoje", edit_journal_entry_path(@today_entry),
          class: "px-4 py-2 border border-cyan-400 text-cyan-300 rounded hover:bg-cyan-400/10" %>
  <% else %>
    <%= link_to "+ Escrever sobre hoje", new_journal_entry_path,
          class: "px-4 py-2 border border-cyan-400 text-cyan-300 rounded hover:bg-cyan-400/10" %>
  <% end %>
</div>

<% if @entries.empty? %>
  <p class="text-slate-400">Nenhum registro ainda. Como foi o seu dia, Caçador?</p>
<% end %>

<ul class="space-y-4">
  <% @entries.each do |entry| %>
    <li class="p-4 border border-slate-700 rounded">
      <div class="flex justify-between items-center mb-2">
        <p class="text-sm text-cyan-400 font-semibold">
          <%= entry.entry_date.strftime("%d/%m/%Y") %>
          <% if entry.entry_date == Date.current %>
            <span class="ml-2 text-xs text-slate-400">· hoje</span>
          <% end %>
        </p>

        <div class="flex items-center gap-3 text-sm">
          <%= link_to "Editar", edit_journal_entry_path(entry), class: "text-slate-400 hover:text-white" %>
          <%= button_to "Apagar", journal_entry_path(entry), method: :delete,
                form: { data: { turbo_confirm: "Apagar este registro?" } },
                class: "text-red-400 hover:text-red-300" %>
        </div>
      </div>

      <p class="text-slate-200 whitespace-pre-line"><%= entry.content %></p>
    </li>
  <% end %>
</ul>