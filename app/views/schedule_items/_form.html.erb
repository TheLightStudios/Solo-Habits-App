<%# app/views/schedule_items/_form.html.erb %>
<%= form_with model: item, class: "space-y-4" do |f| %>
  <% if item.errors.any? %>
    <div class="p-3 border border-red-500 text-red-300 rounded">
      <% item.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :start_time, "Horário", class: "block mb-1 text-sm text-slate-400" %>
    <%= f.text_field :start_time, type: "time",
          class: "w-full p-2 bg-slate-900 text-slate-100 border border-slate-700 rounded" %>
  </div>

  <div>
    <%= f.label :title, "O que fazer", class: "block mb-1 text-sm text-slate-400" %>
    <%= f.text_field :title, placeholder: "Ex.: Treino A",
          class: "w-full p-2 bg-slate-900 text-slate-100 border border-slate-700 rounded" %>
  </div>

  <%= f.submit "Salvar", class: "px-4 py-2 bg-cyan-500 text-slate-950 font-bold rounded cursor-pointer" %>
  <%= link_to "Cancelar", schedule_items_path, class: "ml-3 text-slate-400" %>
<% end %>